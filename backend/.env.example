# Copy to backend/.env for local development without Docker.
ENVIRONMENT=development
# MySQL 8 (or MariaDB 10.4+ for local development). The tests use TEST_DATABASE_URL, which must
# name a separate database containing "test" because the suite wipes it.
DATABASE_URL=mysql+pymysql://signalcraft:signalcraft@localhost:3306/signalcraft?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://signalcraft:signalcraft@localhost:3306/signalcraft_test?charset=utf8mb4
# true = run background tasks in-process (no Redis needed). false = use Celery workers + Redis.
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# simulation never contacts a real provider. Switch to live only with verified credentials.
COMMUNICATION_MODE=simulation
SYSTEM_EMAIL_PROVIDER=simulation
SYSTEM_EMAIL_FROM_NAME=Signalcraft
SYSTEM_EMAIL_FROM_ADDRESS=no-reply@signalcraft.local
BREVO_API_KEY=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEV_MAILBOX_ENABLED=true

# Email webhooks
BREVO_WEBHOOK_TOKEN=
SES_VERIFY_SNS_SIGNATURES=true
# Public URL that providers call back (tracking links, webhooks, call scripts)
BACKEND_PUBLIC_URL=http://localhost:5173

# SMS: Amazon SNS for India (DLT) and the US (10DLC/toll-free), using the AWS_* settings above.
# Only used when COMMUNICATION_MODE=live. Delivery receipts are read from SNS delivery status logs.
# AWS_ACCOUNT_ID is optional (otherwise looked up with STS).
AWS_ACCOUNT_ID=
SNS_SMS_RECEIPTS_ENABLED=true

# Voice: Exotel for India, Twilio for the US.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_APP_ID=
EXOTEL_WEBHOOK_TOKEN=

# Telnyx voice (TeXML). Account id = Telnyx account UUID; the TeXML application must have an
# outbound voice profile. Public key (Keys & Credentials) enables webhook signature checks.
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=
TELNYX_PUBLIC_KEY=

# AI calling agents (Claude). Without a key, agent test chats and simulated calls use an offline,
# scripted responder (marked "simulated"). Live AI calls need Twilio (ConversationRelay) and a public
# HTTPS BACKEND_PUBLIC_URL, since Twilio connects to wss://<host>/api/v1/public/voice/agent/<call>/ws.
ANTHROPIC_API_KEY=
# Model for conversations and post-call extraction. Use this exact id.
AI_AGENT_MODEL=claude-opus-5-5
# Effort for live conversation turns: low keeps replies fast on the phone.
AI_AGENT_EFFORT=low
# Website chatbots: model and effort for visitor replies (uses ANTHROPIC_API_KEY; without it replies are
# simulated and free). Price per AI reply is CHAT_AI_PRICING (JSON) by the app's country.
CHAT_AI_MODEL=claude-opus-5-5
CHAT_AI_EFFORT=low
# BACKEND_PUBLIC_URL must be reachable from customers' websites: the widget loads <BACKEND_PUBLIC_URL>/embed/chat.js

# Live wallet top-ups (hosted payment pages). Stripe for USD wallets, Razorpay for INR wallets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring: /api/v1/metrics needs METRICS_TOKEN (bearer). Sentry needs SENTRY_DSN and sentry-sdk.
METRICS_TOKEN=
SENTRY_DSN=

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=10
LOG_LEVEL=INFO
LOG_JSON=false
