# Copy to frontend/.env.local (development) or set at build time. Only VITE_* variables reach the browser.

# Browser error tracking with Sentry. Leave empty to never load the Sentry SDK.
# No personal data is sent: no cookies, request bodies, user details or typed input; tokens are scrubbed.
VITE_SENTRY_DSN=
# Defaults: the Vite mode (development/production) and signalcraft-frontend@0.1.0.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
