# Copy to backend/.env for local development without Docker.
ENVIRONMENT=development
# SQLite for docker-less development. For MySQL 8:
# DATABASE_URL=mysql+pymysql://signalcraft:signalcraft@localhost:3306/signalcraft?charset=utf8mb4
DATABASE_URL=sqlite:///./var/dev.db
# true = run background tasks in-process (no Redis needed). false = use Celery workers + Redis.
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# simulation never contacts a real provider. Switch to live only with verified credentials.
COMMUNICATION_MODE=simulation
SYSTEM_EMAIL_PROVIDER=simulation
SYSTEM_EMAIL_FROM_NAME=Signalcraft
SYSTEM_EMAIL_FROM_ADDRESS=no-reply@signalcraft.local
BREVO_API_KEY=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEV_MAILBOX_ENABLED=true

# Email webhooks
BREVO_WEBHOOK_TOKEN=
SES_VERIFY_SNS_SIGNATURES=true
# Public URL that providers call back (tracking links, webhooks, call scripts)
BACKEND_PUBLIC_URL=http://localhost:5173

# SMS: MSG91 for India (DLT), Twilio for the US (10DLC). Only used when COMMUNICATION_MODE=live.
MSG91_AUTH_KEY=
MSG91_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Voice: Exotel for India, Twilio for the US (shares the Twilio credentials above).
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_APP_ID=
EXOTEL_WEBHOOK_TOKEN=

# Telnyx voice (TeXML). Account id = Telnyx account UUID; the TeXML application must have an
# outbound voice profile. Public key (Keys & Credentials) enables webhook signature checks.
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=
TELNYX_PUBLIC_KEY=

# Live wallet top-ups (hosted payment pages). Stripe for USD wallets, Razorpay for INR wallets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring: /api/v1/metrics needs METRICS_TOKEN (bearer). Sentry needs SENTRY_DSN and sentry-sdk.
METRICS_TOKEN=
SENTRY_DSN=

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=10
LOG_LEVEL=INFO
LOG_JSON=false
