# Copy to backend/.env for local development without Docker.
ENVIRONMENT=development
# MySQL 8 (or MariaDB 10.4+ for local development). The tests use TEST_DATABASE_URL, which must
# name a separate database containing "test" because the suite wipes it.
DATABASE_URL=mysql+pymysql://signalcraft:signalcraft@localhost:3306/signalcraft?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://signalcraft:signalcraft@localhost:3306/signalcraft_test?charset=utf8mb4
# true = run background tasks in-process (no Redis needed). false = use Celery workers + Redis.
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# simulation never contacts a real provider. Switch to live only with verified credentials.
COMMUNICATION_MODE=simulation
SYSTEM_EMAIL_PROVIDER=simulation
SYSTEM_EMAIL_FROM_NAME=Signalcraft
SYSTEM_EMAIL_FROM_ADDRESS=no-reply@signalcraft.local
BREVO_API_KEY=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEV_MAILBOX_ENABLED=true

# Email webhooks
BREVO_WEBHOOK_TOKEN=
SES_VERIFY_SNS_SIGNATURES=true
# Public URL that providers call back (tracking links, webhooks, call scripts)
BACKEND_PUBLIC_URL=http://localhost:5173

# SMS: Amazon SNS for India (DLT) and the US (10DLC/toll-free), using the AWS_* settings above.
# Only used when COMMUNICATION_MODE=live. Delivery receipts are read from SNS delivery status logs.
# AWS_ACCOUNT_ID is optional (otherwise looked up with STS).
AWS_ACCOUNT_ID=
SNS_SMS_RECEIPTS_ENABLED=true
# SMS is "coming soon" in every market. While false, SMS actions are refused (SMS_COMING_SOON), automation SMS
# steps can't be added and nothing is texted. SMS_UAE_ENABLED additionally gates SMS to/from the UAE.
SMS_ENABLED=false
SMS_UAE_ENABLED=false
# UAE calls stay off until customers can call from their own licensed UAE number.
VOICE_UAE_ENABLED=false

# Voice: Exotel for India, Twilio for the US.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_APP_ID=
EXOTEL_WEBHOOK_TOKEN=

# Telnyx voice (TeXML). Account id = Telnyx account UUID; the TeXML application must have an
# outbound voice profile. Public key (Keys & Credentials) enables webhook signature checks.
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=
TELNYX_PUBLIC_KEY=

# AI calling agents (Claude). Without a key, agent test chats and simulated calls use an offline,
# scripted responder (marked "simulated"). Live AI calls need Twilio (ConversationRelay) and a public
# HTTPS BACKEND_PUBLIC_URL, since Twilio connects to wss://<host>/api/v1/public/voice/agent/<call>/ws.
ANTHROPIC_API_KEY=
# Model for conversations and post-call extraction. Use this exact id.
AI_AGENT_MODEL=claude-opus-5-5
# Effort for live conversation turns: low keeps replies fast on the phone.
AI_AGENT_EFFORT=low
# Website chatbots: model and effort for visitor replies (uses ANTHROPIC_API_KEY; without it replies are
# simulated and free). Price per AI reply is CHAT_AI_PRICING (JSON) by the app's country.
CHAT_AI_MODEL=claude-opus-5-5
CHAT_AI_EFFORT=low
# BACKEND_PUBLIC_URL must be reachable from customers' websites: the widget loads <BACKEND_PUBLIC_URL>/embed/chat.js

# AI Team (in-app AI Assistant, AI agents, automation "AI step") runs on OpenAI. Without a key it runs in a
# deterministic, clearly labelled simulation mode. Fair-use daily limits per plan are in billing/plans.py.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Cheaper model for classification/extraction in the automation AI step (optional).
OPENAI_MODEL_FAST=gpt-6-luna
# Slack app for AI agents ("Add to Slack"). Without client id/secret a simulated Slack (log at /dev/slack) is used.
# See docs/DEPLOYMENT.md → Slack for the app's scopes, redirect URL and interactivity URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Live wallet top-ups (hosted payment pages). Stripe for USD wallets, Razorpay for INR wallets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GST tax invoices for wallet top-ups (the platform is the seller). Prices exclude GST: an INR top-up of X is
# charged X + GST_RATE% and credits X. INR top-ups are refused until SELLER_GSTIN and SELLER_STATE_CODE are set.
SELLER_LEGAL_NAME=Signalcraft
# 15-character GSTIN of the platform, e.g. 29ABCDE1234F1Z5
SELLER_GSTIN=
# Registered address printed on invoices (use \n for new lines)
SELLER_ADDRESS=
# Two-digit GST state code of the registration, e.g. 29 (Karnataka). Same state as the buyer: CGST+SGST; else IGST.
SELLER_STATE_CODE=
SELLER_PAN=
# ARN of the Letter of Undertaking: USD (export) invoices are zero-rated, without payment of IGST under LUT
SELLER_LUT_NUMBER=
# SAC for the service (998431 by default): confirm with your chartered accountant
INVOICE_SAC_CODE=998431
GST_RATE=18
# Invoice numbers: PREFIX/YY-YY/NNNNNN per Indian financial year (GST allows at most 16 characters: keep <= 3)
INVOICE_NUMBER_PREFIX=SC

# Sender domain authentication (SPF / DKIM / DMARC / MX checks shown on the senders page and in readiness)
EMAIL_DNS_CHECKS_ENABLED=true
# SPF include of the sending provider: amazonses.com (SES) or spf.brevo.com (Brevo)
EMAIL_SPF_INCLUDE=amazonses.com
# Comma-separated DKIM selectors to check at <selector>._domainkey.<domain>
EMAIL_DKIM_SELECTORS=signalcraft
# Optional CNAME target for DKIM ({selector} and {domain} are filled in); empty: any DKIM TXT key passes
EMAIL_DKIM_CNAME_TARGET=
EMAIL_DNS_TIMEOUT_SECONDS=3

# Monitoring: /api/v1/metrics needs METRICS_TOKEN (bearer). Sentry (sentry-sdk[fastapi]) is on only when
# SENTRY_DSN is set; no personal data is sent. SENTRY_RELEASE tags events (e.g. a git SHA).
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_RELEASE=
# Browser error tracking: passed to the frontend build; empty = the Sentry SDK is never loaded.
VITE_SENTRY_DSN=

# Database backups (scripts/backup_db.py, see docs/operations.md)
BACKUP_DIR=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=10
LOG_LEVEL=INFO
LOG_JSON=false
